# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas UI → your M0 cluster → "Connect" → "Drivers" → copy the string.
# Replace <db_password> with the DB user's real password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=institutional_memory
MONGODB_COLLECTION=events

# ── Voyage AI (embeddings) ───────────────────────────────────────────────────
# https://dashboard.voyageai.com  → API Keys → Create. Free tier is plenty.
# If this is blank the app silently falls back to a local model so the demo
# NEVER hard-fails on stage.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ── GitHub (ingestion source) ────────────────────────────────────────────────
# Optional but strongly recommended: unauthenticated = 60 req/hr, token = 5000.
# github.com/settings/tokens → "Generate new token (classic)" → no scopes needed
# for public repos.
GITHUB_TOKEN=
GITHUB_REPO=expressjs/express

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# Staleness decay: a result's score is multiplied by 0.5 ** (age_days / HALF_LIFE)
STALENESS_HALF_LIFE_DAYS=540
STALENESS_WEIGHT=0.35
